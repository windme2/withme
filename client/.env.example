# Create .env file from this example
# Copy this file to .env and update the values

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/withme_db"

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_SECRET="withme-super-secret-jwt-key-change-in-production-2026"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="withme-super-secret-refresh-key-change-in-production-2026"
JWT_REFRESH_EXPIRES_IN="30d"

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"
